# dependencies
node_modules/

# build output (no build step in this repo; kept for ad-hoc tooling only)
dist/
.cache/

# environment / secrets
.env
.env.local
.env.*.local
# private owner-token / published-pages log -- MUST NEVER be tracked (public repo)
.claude/brewpage-history.md

# editor / OS
.idea/
.vscode/
.DS_Store
*.swp
*.swo
*.bak

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Claude Code runtime (per-machine state)
.claude/logs/
.claude/tasks/

# Project-level override of ~/.gitignore_global.
# That global config excludes CLAUDE.md and .claude/; in this repo they ARE
# project-tracked artefacts (project identity + team plans + agent definitions),
# so re-include them. Per-machine state above stays ignored.
!CLAUDE.md
!.claude/
!.claude/teams/
!.claude/teams/**
!.claude/agents/
!.claude/agents/**
!.claude/features/
!.claude/features/**
!.claude/rules/
!.claude/rules/**

# Backups + generated agent traces stay ignored even inside re-included .claude/ paths
.claude/**/*.bak
.claude/**/trace.jsonl

# Transient run artefacts (per docs.md reports live here but are not version-tracked
# -- screenshots/QA output bloat history) and machine-local plan symlinks.
.claude/reports/
.claude/plans/

# Stray Playwright MCP output (console logs / page snapshots) dropped by ad-hoc runs
.playwright-mcp/
**/.playwright-mcp/

# Per-machine brewcode runtime state that leaks into a recipe folder (the recipe
# folder publishes to BrewPage verbatim -- keep tooling state out of it)
recipes/**/.claude/
